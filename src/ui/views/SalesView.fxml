<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.SalesControl"
      styleClass="view, sales-view"
      >
    <stylesheets>
        <URL value="@../base.css" />
        <URL value="@../components.css" />
    </stylesheets>    <VBox spacing="24">
        <HBox HBox.hgrow="ALWAYS">
<!--            Buttons -->
            <Button onAction="#NewOrderClick" styleClass="button--primary, button--medium">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@../../icons/cart.png" />
                    </ImageView>
                </graphic>
                New Order
            </Button>
            <Button onAction="#ItemRefundClick" styleClass="button--outline, button--medium">
                <graphic>
                    <ImageView fitHeight="20" fitWidth="20">
                        <Image url="@../../icons/hand-package.png" />
                    </ImageView>
                </graphic>
                Item Refund
            </Button>
        </HBox>
        <VBox VBox.vgrow="ALWAYS" spacing="16">
            <Text>Recent Sales</Text>
            <ScrollPane>
                <ListView fx:id="salesList"/>
            </ScrollPane>
        </VBox>
    </VBox>
    <fx:include source="../components/DashboardStatCard.fxml" fx:id="inventoryValueStatCard"/>
</HBox>
