<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.SalesControl"
      styleClass="view, sales-view"
>
    <stylesheets>
        <URL value="@../base.css"/>
        <URL value="@../components.css"/>
    </stylesheets>
    <VBox spacing="24" minWidth="360" prefWidth="420" HBox.hgrow="ALWAYS">
            <HBox HBox.hgrow="ALWAYS" spacing="8">
                <!--            Buttons -->
                <VBox spacing="24">
                    <Text styleClass="h2">Recent Sales</Text>
                    <HBox spacing = "8">
                        <Button onAction="#NewOrderClick" styleClass="button--primary, button--medium">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20">
                                    <Image url="@../../icons/cart.png"/>
                                </ImageView>
                            </graphic>
                            New Order
                        </Button>
                        <Button fx:id="refundButton" onAction="#ItemRefundClick" styleClass="button--outline, button--medium">
                            <graphic>
                                <ImageView fitHeight="20" fitWidth="20">
                                    <Image url="@../../icons/hand-package.png"/>
                                </ImageView>
                            </graphic>
                            Item Refund
                        </Button>
                    </HBox>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT">
                    <fx:include source="../components/DashboardStatCard.fxml" fx:id="inventoryValueStatCard" HBox.hgrow="ALWAYS"/>
                </HBox>
            </HBox>
        <ListView fx:id="salesList" styleClass="list" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
