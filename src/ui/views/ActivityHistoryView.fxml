<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<?import javafx.scene.text.Text?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.ActivityHistoryController"
      stylesheets="@../base.css"
      styleClass="view"
      prefHeight="400.0" prefWidth="600.0">
    <stylesheets>
        <URL value="@../base.css" />
        <URL value="@../components.css" />
    </stylesheets>
    <Text styleClass="h2">Activity History</Text>
    <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true">
        <ListView fx:id="activityHistoryList"/>
    </ScrollPane>
</VBox>
