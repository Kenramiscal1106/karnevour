<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="application.controllers.views.UpdateProductPriceController">
    <stylesheets>
        <URL value ="@../base.css"/>
        <URL value ="@../components.css"/>
    </stylesheets>
    <TextField fx:id="price" styleClass="adjust-item-controls"/>
    <HBox>
        <Button onAction="#closeDialog">Cancel</Button>
        <Button onAction="#handlePriceUpdate">Update Price</Button>
    </HBox>
</VBox>
