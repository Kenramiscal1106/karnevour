<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="application.controllers.views.UpdateProductPriceController">
    <TextField fx:id="price"/>
    <HBox>
        <Button onAction="#handleCancel">Cancel</Button>
        <Button onAction="#handlePriceUpdate">Update Price</Button>
    </HBox>
</VBox>
