<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="application.controllers.views.UpdateProductPriceController"
      prefWidth="512" styleClass='mini-prompt'>
    <stylesheets>
        <URL value ="@../base.css"/>
        <URL value ="@../components.css"/>
    </stylesheets>
    <VBox styleClass="form-field">
        <TextField fx:id="price"/>
    </VBox>
    <HBox spacing="8">
        <Button onAction="#closeDialog" styleClass="button--primary, button--medium">Cancel</Button>
        <Button onAction="#handlePriceUpdate" styleClass="button--primary, button--medium">Update Price</Button>
    </HBox>
</VBox>
