<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:id="root"
      fx:controller="application.controllers.views.AddProductController">
    <VBox>
        <Label labelFor="${productName}">Product name</Label>
        <TextField fx:id="productName"/>
    </VBox>
    <VBox>
        <Label labelFor="${description}">Description</Label>
        <TextArea fx:id="description"/>
    </VBox>
    <VBox>
        <Label labelFor="${price}">Price</Label>
        <TextField fx:id="price"/>
    </VBox>
    <VBox>
        <Label labelFor="${lowStockLimit}">Stock Limit Warning</Label>
        <TextField fx:id="lowStockLimit"/>
    </VBox>
    <HBox>
        <Button onAction="#closeDialog">Cancel</Button>
        <Button onAction="#addProductButton">Add</Button>
    </HBox>
</VBox>
