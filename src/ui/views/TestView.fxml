<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<HBox alignment="CENTER" xmlns:fx="http://javafx.com/fxml" fx:controller="application.controllers.views.HelloController">
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color:#FFEEF1">
        <Label fx:id="helloText">Hello, World</Label>
        <Button onMouseClicked="#buttonClick">Click me!!!</Button>
    </VBox>
</HBox>