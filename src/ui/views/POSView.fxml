<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.POSController"
      prefHeight="840" prefWidth="1000" styleClass="pos-window">
    <stylesheets>
        <URL value="@../base.css"/>
        <URL value="@../components.css"/>
    </stylesheets>
    <VBox>
        <ListView fx:id="selectedList" prefWidth="560"/>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox>
            <HBox>
                <Text>Sold to</Text>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="soldTo"/>
            </HBox>
            <HBox>
                <Text>Tendered</Text>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="tenderedField"/>
            </HBox>
            <HBox>
                <Text>Net Total</Text>
                <Region HBox.hgrow="ALWAYS"/>
                <Text fx:id="totalText"/>
            </HBox>
            <HBox>
                <Text>Change</Text>
                <Region HBox.hgrow="ALWAYS"/>
                <Text fx:id="change"/>
            </HBox>
        </VBox>
        <HBox spacing="8">
            <Button fx:id="cancelButton" styleClass="button--primary, button--medium">Cancel Order</Button>
            <Button fx:id="checkoutButton" styleClass="button--outline, button--medium">Checkout</Button>
        </HBox>
    </VBox>
    <ListView fx:id="choicesList" prefWidth="360"/>

</HBox>
