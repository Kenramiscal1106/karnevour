<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import java.net.URL?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.POSController"
      prefHeight="840" prefWidth="1000" styleClass="pos-window">
    <stylesheets>
        <URL value="@../base.css" />
        <URL value="@../components.css" />
    </stylesheets>
    <VBox>
        <ListView fx:id="selectedList"/>
        <Region VBox.vgrow="ALWAYS"/>
        <VBox>
            <HBox>
                <Text>Net Total</Text>
                <Region HBox.hgrow="ALWAYS"/>
                <Text fx:id="totalText"/>
            </HBox>
        </VBox>
        <HBox>
            <Button styleClass="button--primary, button--medium">Cancel Order</Button>
            <Button styleClass="button--outline, button--medium">Checkout</Button>
        </HBox>
    </VBox>
    <ScrollPane>
        <ListView fx:id="choicesList"/>
    </ScrollPane>
</HBox>
