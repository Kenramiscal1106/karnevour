<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<VBox alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.InventoryController"
      stylesheets="@/style.css" VBox.vgrow="ALWAYS" styleClass="view">
    <padding>
        <Insets topRightBottomLeft="32"/>
    </padding>
    <HBox styleClass="inventory-actions">
        <Button onAction="#addInventoryClick" styleClass="button--primary, button--medium">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@../../icons/add-box.png"/>
                </ImageView>
            </graphic>
            Add to Inventory
        </Button>
        <Button onAction="#subtractInventoryClick" styleClass="button--outline, button--medium">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@../../icons/edit-box.png"/>
                </ImageView>
            </graphic>
            Subtract from Inventory
        </Button>
    </HBox>
    <VBox>
        <Text>Recent Sales</Text>
        <ScrollPane fitToWidth="true" styleClass="inventory-entries-root">
            <ListView fx:id="inventoryList" styleClass="inventory-entries"/>
        </ScrollPane>
    </VBox>
</VBox>
