<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.InventoryController"
      stylesheets="@/style.css">
    <padding>
        <Insets topRightBottomLeft="32"/>
    </padding>
    <HBox>
        <Button fx:id="InventoryButton" onAction="#addInventoryClick">Add to Inventory</Button>
        <Button fx:id="subtractInventoryButton" onAction="#subtractInventoryClick">Subtract from Inventory</Button>
    </HBox>
    <VBox fx:id="container" VBox.vgrow="ALWAYS" spacing="4" styleClass="inventory-entries">
    </VBox>
</VBox>
