<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.RefundController"
      prefHeight="200" prefWidth="512.0" styleClass="mini-prompt">
    <stylesheets>
        <URL value="@../base.css" />
        <URL value="@../components.css" />
    </stylesheets>
    <ComboBox fx:id="itemSelector" promptText="Select Sale">
    </ComboBox>
    <fx:include source="../components/RefundEntry.fxml" fx:id="refundEntry"/>
    <HBox>
        <Button styleClass="button--outline, button--medium" fx:id="windowCloseButton">
            Cancel
        </Button>
        <Button styleClass="button--primary, button--medium" fx:id="addInventoryButton">
            Refund Item
        </Button>
    </HBox>
</VBox>
