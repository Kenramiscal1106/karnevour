<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import java.net.URL?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.SubtractInventoryController"
      prefHeight="200" prefWidth="512.0" styleClass="mini-prompt">
    <stylesheets>
        <URL value="@../base.css"/>
        <URL value="@../components.css"/>
    </stylesheets>
    <ComboBox fx:id="itemSelector" promptText="Select Item">
    </ComboBox>
    <fx:include source="../components/AdjustItem.fxml" fx:id="adjustItem"/>
    <HBox>
        <Button styleClass="button--outline, button--medium" fx:id="windowCloseButton" onAction="#close">
            Cancel
        </Button>
        <Button styleClass="button--primary, button--medium" fx:id="confirmActionButton" onAction="#confirm">
            Subtract Inventory
        </Button>
    </HBox>
</VBox>
