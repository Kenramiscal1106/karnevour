<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.views.SubtractInventoryController"
      prefHeight="200" prefWidth="512.0" stylesheets="@/style.css" styleClass="mini-prompt">
    <ComboBox fx:id="itemSelector">
    </ComboBox>
    <fx:include source="../components/AdjustItem.fxml" fx:id="adjustItemController"/>
    <HBox>
        <Button styleClass="button--ghost,button--medium" fx:id="windowCloseButton">
            Cancel
        </Button>
        <Button styleClass="button--primary, button--medium" fx:id="addInventoryButton">
            Subtract Inventory
        </Button>
    </HBox>
</VBox>
