<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.DashboardStatCardController" styleClass="stat-card">
    <VBox styleClass="">
        <Text fx:id="secondaryText" styleClass="stat-card-descriptor"/>
        <Text fx:id="primaryText" styleClass="stat-card-value"/>
    </VBox>
    <Region />
    <ImageView fx:id="imageContainer" fitWidth="40" fitHeight="40"/>
</HBox>
