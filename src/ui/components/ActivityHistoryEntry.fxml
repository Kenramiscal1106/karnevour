<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<?import java.net.URL?>
<?import javafx.scene.image.Image?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.ActivityHistoryEntryController">
    <stylesheets>
        <URL value="@../base.css"/>
        <URL value="@../components.css"/>
    </stylesheets>
    <HBox styleClass="inventory-entry" spacing="16" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
        <ImageView fx:id="imageView" fitHeight="15" fitWidth="15">
            <Image url="@../../icons/log.png"/>
        </ImageView>
        <VBox alignment="CENTER_LEFT">
            <Text fx:id="logText" styleClass="product-entry-description"/>
        </VBox>
    </HBox>
</HBox>
