<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.POSSelectionEntryController"
      prefHeight="400.0" prefWidth="600.0">
    <HBox>
        <ImageView fx:id="checkoutImage" fitHeight="56" fitWidth="56"/>
        <VBox>
            <Text fx:id="productName"/>
            <Text fx:id="productPrice"/>
        </VBox>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox>
        <HBox>
            <Button fx:id="minusButton"></Button>
            <HBox>
                <TextField/>
                <Text fx:id="unitText"/>
            </HBox>
            <Button fx:id="plusButton"></Button>
        </HBox>
        <Button fx:id="removeButton">Remove</Button>
    </HBox>
</HBox>
