<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Rectangle?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.POSSelectionEntryController"
      styleClass="pos-selection-entry">
    <HBox alignment="CENTER_LEFT" spacing="8">
        <ImageView fx:id="checkoutImage" fitHeight="56" fitWidth="56">
            <clip>
                <Rectangle width="56" height="56" arcWidth="16" arcHeight="16"/>
            </clip>
        </ImageView>
        <VBox alignment="CENTER_LEFT">
            <Text fx:id="productName" styleClass="product-entry-name"/>
            <Text fx:id="productPrice"/>
        </VBox>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox alignment="CENTER_RIGHT" spacing="8">
        <HBox alignment="CENTER" spacing="8">
            <Button fx:id="minusButton" onAction="#decrement">
                <graphic>
                    <ImageView fitWidth="20" fitHeight="20">
                        <Image url="@../../icons/minus.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <HBox alignment="CENTER">
                <HBox alignment="CENTER" spacing="4" >
                    <TextField fx:id="quantityField" styleClass="adjust-item-input" alignment="CENTER"/>
                    <Text fx:id="unitText" textAlignment="CENTER"/>
                </HBox>
            </HBox>
            <Button fx:id="plusButton" onAction="#increment">
                <graphic>
                    <ImageView fitWidth="20" fitHeight="20">
                        <Image url="@../../icons/plus.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
        <Button fx:id="removeButton" onAction ="#removeClick" styleClass="button--primary, button--medium">Remove</Button>
    </HBox>
</HBox>
