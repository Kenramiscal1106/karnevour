<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.shape.Rectangle?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="inventory-entry"
      stylesheets="@../base.css">
    <HBox styleClass="inventory-entry__leading-detail" spacing="16" alignment="CENTER_LEFT">
        <ImageView fx:id="imageView" fitHeight="56" fitWidth="56">
            <clip>
                <Rectangle width="56" height="56" arcWidth="16" arcHeight="16"/>
            </clip>
        </ImageView>
        <VBox alignment="CENTER_LEFT">
            <Text fx:id="itemName" styleClass="inventory-entry-name"/>
            <Text fx:id="itemQuantity" styleClass="inventory-entry-quantity"/>
        </VBox>
    </HBox>
</HBox>
