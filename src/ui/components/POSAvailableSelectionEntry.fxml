<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.POSAvailableSelectionEntryController"
      styleClass="pos-available-entry"
      alignment="CENTER">
    <HBox spacing="8">
        <ImageView fx:id="availableImage" fitHeight="56" fitWidth="56"/>
        <VBox alignment="CENTER_LEFT">
            <Text fx:id="productName" styleClass="product-entry-name"/>
            <Text fx:id="productRemaining"/>
        </VBox>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Button fx:id="addButton" onAction="#addClick" styleClass="button--primary, button--medium">Add</Button>
</HBox>
