<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.shape.SVGPath?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Text?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.ManagerNavigationRailController"
      prefWidth="108" stylesheets="@/style.css" alignment="CENTER" spacing="32" styleClass="navigation-rail">
    <padding>
        <Insets top="16" bottom="32"/>
    </padding>
    <!--  Logo  -->
    <VBox VBox.vgrow="ALWAYS" spacing="12">
        <padding>
            <Insets left="2" right="2" top="12" bottom="12"/>
        </padding>
        <Button contentDisplay="TOP" alignment="CENTER" styleClass="navigation-item" VBox.vgrow="ALWAYS" maxWidth="1000"
                onAction="#homeClick" fx:id="homeButton">
            <graphic>
                <VBox styleClass="icon-container" alignment="CENTER" fillWidth="false">
                    <padding>
                        <Insets left="12" right="12" top="2" bottom="2"/>
                    </padding>
                    <ImageView fitWidth="32" fitHeight="32" fx:id="homeIcon">
                        <Image url="@../../icons/home.png" preserveRatio="true"/>
                    </ImageView>
                </VBox>
            </graphic>
            Home
        </Button>
        <Button contentDisplay="TOP" styleClass="navigation-item" VBox.vgrow="ALWAYS" maxWidth="1000"
                onAction="#saleClick"
                fx:id="saleButton">
            <graphic>
                <VBox styleClass="icon-container" alignment="CENTER" fillWidth="false">
                    <padding>
                        <Insets left="12" right="12" top="2" bottom="2"/>
                    </padding>
                    <ImageView fitWidth="32" fitHeight="32" fx:id="saleIcon">
                        <Image url="@../../icons/tag.png" preserveRatio="true"/>
                    </ImageView>
                </VBox>
            </graphic>
            Sale
        </Button>
        <Button contentDisplay="TOP" styleClass="navigation-item" VBox.vgrow="ALWAYS" maxWidth="1000" onAction="#inventoryClick"
                fx:id="inventoryButton">
            <graphic>
                <VBox styleClass="icon-container" alignment="CENTER" fillWidth="false">
                    <padding>
                        <Insets left="12" right="12" top="2" bottom="2"/>
                    </padding>
                    <ImageView fitWidth="32" fitHeight="32" fx:id="inventoryIcon">
                        <Image url="@../../icons/warehouse.png" preserveRatio="true"/>
                    </ImageView>
                </VBox>
            </graphic>
            Inventory
        </Button>
        <Button contentDisplay="TOP" styleClass="navigation-item" VBox.vgrow="ALWAYS" maxWidth="1000" onAction="#activityHistoryClick"
                fx:id="activityHistoryButton" wrapText="true" textAlignment="CENTER">
            <graphic>
                <VBox styleClass="icon-container" alignment="CENTER" fillWidth="false">
                    <padding>
                        <Insets left="12" right="12" top="2" bottom="2"/>
                    </padding>
                    <ImageView fitWidth="32" fitHeight="32" fx:id="historyIcon">
                        <Image url="@../../icons/history.png" preserveRatio="true"/>
                    </ImageView>
                </VBox>
            </graphic>
            Activity History
        </Button>
    </VBox>
    <fx:include source="LogoutButton.fxml"/>
    <!--  Bottom Section  -->
</VBox>
