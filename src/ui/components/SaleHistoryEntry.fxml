<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.image.ImageView?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.SalesHistoryEntryController">
    <HBox>
        <ImageView fitWidth="56" fitHeight="56" fx:id="imageDisplay" >

        </ImageView>
        <VBox>
            <Text fx:id="primaryText"/>
            <Text fx:id="secondaryText"/>
        </VBox>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <Text fx:id="priceLabel"/>
</HBox>
