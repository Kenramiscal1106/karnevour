<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.image.Image?>
<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.controllers.components.AdjustItemController"
      prefHeight="400.0" prefWidth="600.0">
    <HBox>
        <ImageView fx:id="itemImage"/>
        <VBox>
            <Text fx:id="itemNameText"/>
            <Text fx:id="itemQuantityText"/>
        </VBox>
    </HBox>
    <Region HBox.hgrow="ALWAYS"/>
    <HBox>
        <Button styleClass="button--adjust">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@../../icons/minus.png"/>
                </ImageView>
            </graphic>
        </Button>
        <HBox>
            <TextField fx:id="quantityField" />
            <Text fx:id="unitField"/>
        </HBox>
        <Button styleClass="button--adjust">
            <graphic>
                <ImageView fitWidth="20" fitHeight="20">
                    <Image url="@../../icons/plus.png"/>
                </ImageView>
            </graphic>
        </Button>
    </HBox>
</HBox>
